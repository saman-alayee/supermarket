# Production (Mizbanfa / kiaakala.ir)
PORT=3001
NODE_ENV=production

# MySQL - fill from cPanel MySQL section
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME"

# Redis optional
REDIS_DISABLED=true

# JWT - use a long random secret in production
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# OTP
OTP_EXPIRES_MINUTES=5
OTP_DEV_MODE=false

# FarazSMS / Iran Payamak (required when OTP_DEV_MODE=false)
FARAZSMS_API_KEY=
FARAZSMS_PATTERN_CODE=
FARAZSMS_LINE_NUMBER=90008361
FARAZSMS_NUMBER_FORMAT=english
FARAZSMS_OTP_ATTRIBUTE=code

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# CORS + frontend
CORS_ORIGIN=https://kiaakala.ir,https://www.kiaakala.ir,http://45.94.215.57

# Admin seed (first deploy only)
ADMIN_PHONE=09120000000
ADMIN_PASSWORD=change-admin-password
